
DELTA_API_KEY=your_delta_api_key_here
DELTA_API_SECRET=your_delta_api_secret_here

# --- ZeroMQ Configuration ---
# ZeroMQ connection address for the streaming broker and subscriber clients.
# Core code defaults to: ipc:///tmp/data_streamer.ipc (change to tcp address below if needed)
CRYPALGOS_ZMQ_ADDRESS=tcp://127.0.0.1:5555

# --- Market Data Stream Settings ---
# Comma-separated symbols used by the streamer_service.py script
CRYPALGOS_SYMBOLS=BTCUSD,ETHUSD,SOLUSD,XRPUSD
